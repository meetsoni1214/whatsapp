{
  "name": "event-chat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm --recursive build",
    "dev": "pnpm --filter @event-chat/contracts build && pnpm --parallel --filter @event-chat/api --filter @event-chat/web dev",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive --if-present test",
    "db:up": "docker compose up -d postgres",
    "db:test:up": "docker compose up -d postgres-test",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @event-chat/api db:generate",
    "db:migrate": "pnpm --filter @event-chat/api db:migrate",
    "test:integration": "pnpm --filter @event-chat/api test:integration"
  }
}
